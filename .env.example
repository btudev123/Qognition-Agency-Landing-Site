# ── Durable lead capture: GoHighLevel / LeadConnector + Redis ─────────────
# Server-only integration with contacts read/write and contact notes read/write.
# Contact API version 2021-07-28; notes API version v3. Verify account scopes.
# Configure GHL email deduplication. These fields are dedicated website fields,
# never assignedTo, DND, tags, sales lifecycle, pipeline or opportunity stages.
# inquiry = latest summary; submission = latest reference; history = GHL notes.
# Acceptance model (operator decision 2026-10-06):
#   GHL contact + verified enquiry note committed  -> 200 status "captured".
#   GHL not configured, unavailable or invalid      -> internal email sent synchronously;
#     Resend ok -> 200 status "emailed", fallback: true. Resend skipped/failed -> retryable 503.
#   misconfigured (duplicate field IDs, partial ledger, GHL 401) also falls back, and logs an error.
#   submission_conflict -> 409. busy / lease_lost / reconciliation_required -> 503, no email.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_INQUIRY_FIELD_ID=
GHL_SUBMISSION_FIELD_ID=
GHL_QUALIFICATION_FIELD_ID=
# The consent field records "opt-in-requested" or "not-opted-in". A form tick is a request,
# not consent: any GHL nurture workflow must trigger only on a confirmed double opt-in.
GHL_MARKETING_CONSENT_FIELD_ID=
GHL_LOCALE_FIELD_ID=
# OPTIONAL. A dedicated text field for cookie-consent evidence, written as JSON:
# {"basis":"explicit"|"region_default"|"unknown","country":"US"|null,"gpc":true|false}.
# country comes from x-vercel-ip-country and gpc from the Sec-GPC header, never the form.
# The same object is always on the enquiry note as consent_evidence, field or not.
GHL_CONSENT_BASIS_FIELD_ID=

# OPTIONAL. Adds exactly-once email and Meta CAPI on retries; without it a retry can resend.
# Leave all three empty to run without it. Setting only some of them is a configuration error.
# Existing Upstash Redis REST database, HTTPS endpoint; no automatic provisioning.
# Receipt keys are scoped by VERCEL_ENV + GHL_LOCATION_ID. Receipts expire LEAD_LEDGER_TTL_DAYS
# after their last write (default 760: about 24 months plus margin, matching the privacy notice).
# Configure durable persistence and no eviction; define retention/erasure operations.
# A stable random secret of at least 32 characters; rotation requires a receipt migration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LEAD_LEDGER_HMAC_SECRET=
# Whole days, 1 to 3650. Unset means 760. Any other value makes the ledger misconfigured.
LEAD_LEDGER_TTL_DAYS=

# Vercel supplies VERCEL_ENV. Only VERCEL_ENV=production permits real lead writes.
# Preview defaults to disabled; validate performs zero CRM/email/conversion writes.
# Never assign production to VERCEL_ENV locally to make a preview form appear successful.
QOGNITION_PREVIEW_MODE=
QOGNITION_LEAD_MODE=
# Optional verified sandbox calendar for preview (never the production calendar).
QOGNITION_PREVIEW_CALENDAR_URL=

# ── Email (Resend): notifications, and the lead record when GHL is down ─────
# After a GHL capture, email is a notification and its failure does not undo capture.
# Without GHL, the internal email IS the lead record: if it is not sent, the form fails.
# Skips and rejections log only a reason code, status and Resend error name.
RESEND_API_KEY=
RESEND_FROM=Qognition Agency <hello@qognitionagency.com>
AUDIT_NOTIFY_EMAIL=hello@qognitionagency.com
# Email fallback when GHL cannot capture. Default on (unset). Set to "off" for strict
# GHL-first, where a GHL failure always returns a retryable 503.
LEAD_EMAIL_FALLBACK=

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The pixel (components/shared/MetaPixel.tsx) and the server-side CAPI call
# (lib/metaCapi.ts) send the same event_id for one conversion so Meta counts it
# once. Both are inert until these are set.
#   Pixel ID:     Events Manager > Data Sources > Add > Web
#   CAPI token:   that pixel > Settings > Conversions API > Generate access token
# META_TEST_EVENT_CODE routes events to Events Manager > Test Events instead of
# production data — set it while validating, remove it before going live.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=

# Analytics / tracking
NEXT_PUBLIC_GTM_ID=GTM-M83XBQG2
NEXT_PUBLIC_GA4_ID=G-4S2F6T5QET
NEXT_PUBLIC_CLARITY_ID=x9bhw0zqaf
NEXT_PUBLIC_ENABLE_MARKETING_SCRIPTS=false

# Shared secret for GET /api/integrations/status. Without a matching x-status-secret
# header the endpoint returns only {"ok":true}. With it, configuration detail; add
# ?deep=1 to also call Resend live to prove the credential works.
INTEGRATIONS_STATUS_SECRET=

# GHL booking: public URL lives in data/siteConfig.ts (BOOKING_LINK).
# Native GHL appointments/pipeline are authoritative. No website webhook yet.

# Tally remains available to legacy calculator components only. Shared lead
# forms always use /api/lead for acceptance (GHL, or email fallback) and qualification.
TALLY_API_KEY=
NEXT_PUBLIC_TALLY_FORM_ID=
NEXT_PUBLIC_LEAD_TRANSPORT=

# ── Sanity CMS ──────────────────────────────────────────────────────────────
# Studio is mounted in this app at /studio. Project id and dataset are public.
# SANITY_API_WRITE_TOKEN is server-only — used by scripts/migrate-to-sanity.ts
# and any future write paths. Never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SANITY_PROJECT_ID=ngv93z0z
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook (Sanity -> /api/revalidate). Must match
# the secret configured on the webhook in sanity.io/manage. Without it the route
# returns 503 and edits fall back to the 60s ISR window instead of being instant.
SANITY_REVALIDATE_SECRET=

# ── AI answer engine for the /api/audit AI half (OPTIONAL) ──────────────────
# Perplexity Sonar. One call per audit, inside the request.
#
# LEAVE THIS UNSET AND NOTHING BREAKS. With no key, /api/audit still runs the
# full 28-check crawl and returns aiVisibility.status = 'not_checked' with a
# reason. It NEVER returns a guess. Removing the key is the kill switch.
#
# BEFORE SETTING IT: set a hard monthly spend cap in the Perplexity dashboard.
# That cap is the ONLY real ceiling. lib/auditRateLimit.ts is in-memory and
# per-instance (Redis is unset in production), so it throttles but does not cap.
# An empty value here counts as unset, deliberately: Vercel has registered vars
# with empty values on this account before and broken integrations silently.
PERPLEXITY_API_KEY=
