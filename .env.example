# Vercel supplies VERCEL_ENV. Only VERCEL_ENV=production permits real lead writes.
# Preview defaults to disabled; validate performs zero email/conversion writes.
# Never assign production to VERCEL_ENV locally to make a preview form appear successful.
QOGNITION_PREVIEW_MODE=
QOGNITION_LEAD_MODE=
# Optional verified sandbox calendar for preview (never the production calendar).
QOGNITION_PREVIEW_CALENDAR_URL=

# ── Email (Resend): the lead record (operator, 2026-10-14) ─────────────────
# /api/lead reports success only when Resend accepts the hello@ notification.
# If it is not sent, the form returns a retryable 503. Skips and rejections log
# only a reason code, status and Resend error name.
RESEND_API_KEY=
RESEND_FROM=Qognition Agency <hello@qognitionagency.com>
AUDIT_NOTIFY_EMAIL=hello@qognitionagency.com

# ── Booking (Cal.com) ───────────────────────────────────────────────────────
# Cal.com API key. Reported by /api/integrations/status; no code calls the API yet.
CALCOM_API_KEY=
# Signs the BOOKING_CREATED webhook to /api/cal/webhook. Unset means every delivery is a 503.
CALCOM_WEBHOOK_SECRET=

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The pixel (components/shared/MetaPixel.tsx) and the server-side CAPI call
# (lib/metaCapi.ts) send the same event_id for one conversion so Meta counts it
# once. Both are inert until these are set.
#   Pixel ID:     Events Manager > Data Sources > Add > Web
#   CAPI token:   that pixel > Settings > Conversions API > Generate access token
# META_TEST_EVENT_CODE routes events to Events Manager > Test Events instead of
# production data — set it while validating, remove it before going live.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=

# Analytics / tracking
NEXT_PUBLIC_GTM_ID=GTM-M83XBQG2
NEXT_PUBLIC_GA4_ID=G-4S2F6T5QET
NEXT_PUBLIC_CLARITY_ID=x9bhw0zqaf
NEXT_PUBLIC_ENABLE_MARKETING_SCRIPTS=false

# Shared secret for GET /api/integrations/status. Without a matching x-status-secret
# header the endpoint returns only {"ok":true}. With it, configuration detail; add
# ?deep=1 to also call Resend live to prove the credential works.
INTEGRATIONS_STATUS_SECRET=

# Tally remains available to legacy calculator components only. Shared lead
# forms always use /api/lead (Resend) for acceptance and qualification.
TALLY_API_KEY=
NEXT_PUBLIC_TALLY_FORM_ID=

# ── Sanity CMS ──────────────────────────────────────────────────────────────
# Studio is mounted in this app at /studio. Project id and dataset are public.
# SANITY_API_WRITE_TOKEN is server-only — used by scripts/migrate-to-sanity.ts
# and any future write paths. Never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SANITY_PROJECT_ID=ngv93z0z
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook (Sanity -> /api/revalidate). Must match
# the secret configured on the webhook in sanity.io/manage. Without it the route
# returns 503 and edits fall back to the 60s ISR window instead of being instant.
SANITY_REVALIDATE_SECRET=

# ── AI answer engine for the /api/audit AI half (OPTIONAL) ──────────────────
# Perplexity Sonar. One call per audit, inside the request.
#
# LEAVE THIS UNSET AND NOTHING BREAKS. With no key, /api/audit still runs the
# full 28-check crawl and returns aiVisibility.status = 'not_checked' with a
# reason. It NEVER returns a guess. Removing the key is the kill switch.
#
# BEFORE SETTING IT: set a hard monthly spend cap in the Perplexity dashboard.
# That cap is the ONLY real ceiling. lib/auditRateLimit.ts is in-memory and
# per-instance (there is no shared store), so it throttles but does not cap.
# An empty value here counts as unset, deliberately: Vercel has registered vars
# with empty values on this account before and broken integrations silently.
PERPLEXITY_API_KEY=
